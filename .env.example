# Copy this file to .env and fill in real values. Never commit .env.

# --- Groq (LLM answer generation, server-side only) ---
GROQ_API_KEY=your_groq_api_key_here
# openai/gpt-oss-120b is Production tier and available on the free/developer
# plan. (llama-3.3-70b-versatile is now Enterprise-only and returns 404.)
# openai/gpt-oss-20b is a cheaper, faster alternative.
GROQ_MODEL=openai/gpt-oss-120b
# Optional: point the Groq client at a compatible gateway or a local test
# stub. Leave unset to use https://api.groq.com.
# GROQ_BASE_URL=http://localhost:8787

# --- MongoDB Atlas (application data) ---
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/documind

# --- ChromaDB (local Docker, vector storage) ---
# Not running by default. Start it with:
#   mkdir -p chroma-data
#   docker run --rm --name documind-chroma \
#     -p 8000:8000 \
#     -v "$(pwd)/chroma-data:/data" \
#     chromadb/chroma

# Expected URL: http://localhost:8000
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_COLLECTION=documind
